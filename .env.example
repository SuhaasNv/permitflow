# PermitFlow environment. Copy to .env for local development. Never commit .env.

# Runtime: development | test | production
APP_ENV=development

# PostgreSQL (Postgres only; no SQLite fallback)
DATABASE_URL=postgresql+psycopg://permitflow:permitflow@localhost:5432/permitflow
# Used by pytest; created by docker/init-test-db.sql on first `docker compose up`
TEST_DATABASE_URL=postgresql+psycopg://permitflow:permitflow@localhost:5432/permitflow_test

# Auth. JWT_SECRET is required in every environment (at least 16 random characters; the placeholder below is refused).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=480
# One live session per account (US-093): a session unseen for this many minutes ends by itself.
SESSION_IDLE_MINUTES=60

# CORS allowlist for the frontend (comma separated)
CORS_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=10485760
# Everything one application holds on the volume (every document version, clarification evidence, the licence), US-085.
STORAGE_BUDGET_BYTES=157286400

# Where uploads live (US-097, ADR-015): local (the disk under UPLOAD_DIR, the default) or s3 (an S3-compatible
# bucket). With s3 the app refuses to start unless the three marked values are set. No default is a real credential.
STORAGE_BACKEND=local
# Local MinIO (docker compose --profile storage up -d minio minio-init), for a backend running on the host:
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=permitflow-uploads              # required with s3
# S3_ACCESS_KEY_ID=permitflow               # required with s3 (MinIO's development user, from docker-compose.yml)
# S3_SECRET_ACCESS_KEY=permitflow-local     # required with s3 (secret; MinIO's development value)
# S3_REGION=us-east-1
# S3_ADDRESSING_STYLE=path                  # auto (default) | path (MinIO) | virtual
# A Railway bucket: take the endpoint, bucket name, region and keys from the bucket's Credentials tab.

# Proxy addresses whose X-Forwarded-For the limiters trust (the hop the proxy appended, never the caller's),
# or * behind a platform edge proxy such as Railway. Empty locally: the socket address is the client.
TRUSTED_PROXIES=
# Behind a trusted proxy, the header the edge writes with the connecting client's address, read before
# X-Forwarded-For (Railway: X-Real-IP; US-082). Ignored without a trusted proxy; empty disables it.
CLIENT_IP_HEADER=X-Real-IP
# Database connection pool (US-044). Exhaustion answers 503 after DB_POOL_TIMEOUT_SECONDS instead of hanging.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=5

# Failed sign-ins per client IP per minute (SEC-010); disabled when APP_ENV=test.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Request limits per client IP per minute (US-058): every request, and sign-in attempts of any outcome. 0 disables.
RATE_LIMIT_PER_MINUTE=240
LOGIN_ATTEMPTS_PER_MINUTE=20
# Quotas counted in the database (US-058): open drafts per operator; verification runs per applicant and per platform per day.
MAX_DRAFTS_PER_USER=20
AI_RUNS_PER_USER_PER_DAY=60
AI_RUNS_PER_DAY=1000

# Mark site visit done and the checklist submit wait for the visit day, Singapore date (UAT run 5, F12).
# false only where a whole appointment runs in one sitting: the browser suite, the UAT scripts, a demonstration.
SITE_VISIT_DAY_GUARD=true

# AI verification. AI_PROVIDER=mock needs no key.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
AI_CONFIDENCE_THRESHOLD=0.6
AI_MAX_TEXT_CHARS=20000

# LangSmith tracing of the OpenAI provider (US-055). Off without a key. Region is fixed at sign-up:
# US https://api.smith.langchain.com, EU https://eu.api.smith.langchain.com, APAC (Sydney) https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=permitflow
# Inputs (document text, form section) hidden by default; set false in development only.
LANGSMITH_HIDE_INPUTS=true

# Frontend: Vite reads VITE_* from frontend/.env at build time (see frontend/.env.example), not from this file.

# Read by backend/scripts/seed.py only, never by the app: the demo accounts' password (default PermitFlow!2026).
# SEED_PASSWORD=PermitFlow!2026
# The administrator's password. Outside production it falls back to SEED_PASSWORD; with APP_ENV=production
# the seed refuses to run unless this is set to a private value (never the published one). Generate: openssl rand -base64 18
# SEED_ADMIN_PASSWORD=
# Production demo accounts are opt-in (US-103). With APP_ENV=production the operator, officer and spare officer are
# seeded only when this is true (the published SEED_PASSWORD default is then allowed) or when SEED_PASSWORD is a
# private value; otherwise only the administrator is seeded. An explicit SEED_PASSWORD=PermitFlow!2026 in
# production without this flag is refused. Ignored outside production, where every account is always seeded.
# SEED_PUBLIC_DEMO=false

# Observability (US-077). The API serves GET /api/v1/metrics only when METRICS_TOKEN is set; Prometheus
# presents it as a bearer token. Leave empty to keep the endpoint off. Generate: openssl rand -hex 24
METRICS_TOKEN=
# Local Prometheus and Grafana: docker compose --profile observability up -d (Grafana on :3001).
# METRICS_TARGET=host.docker.internal:8000   # backend:8000 when the backend runs in Compose (--profile full)
# GRAFANA_ADMIN_PASSWORD=permitflow
# Telegram alerts from Grafana (optional, US-077): a bot from @BotFather and the chat id of the conversation
# with it. Both set: the seven rules and an hourly digest notify that chat; either empty: no alerting provisioned.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Platform settings (US-101). RATE_LIMIT_PER_MINUTE, LOGIN_ATTEMPTS_PER_MINUTE, AI_RUNS_PER_USER_PER_DAY, AI_RUNS_PER_DAY,
# MAX_DRAFTS_PER_USER, UPLOAD_MAX_BYTES and AI_MAX_TEXT_CHARS above are the defaults AND the ceilings of what an administrator
# can set from the admin settings API: it can lower them (never below a small minimum, never switch one off), not raise them.
# Worker concurrency has the same shape; the verification worker reads it (US-098).
WORKER_CONCURRENCY=2
# The same two Telegram values also let the API announce each settings change in that chat (empty: no message). Set them
# on the backend as well as on Grafana and the bot to get the announcement.

# Where the document checks run (US-098, ADR-016). inline (the default): in the API process, as before.
# worker: the API only queues the check and `python -m app.worker` (docker compose --profile worker) runs it.
# Rollback is setting this back to inline and restarting the API; nothing else changes.
VERIFICATION_MODE=inline
# Worker only. A claimed check that has not finished after this many seconds is taken back by the reaper
# (requeued, or marked dead after three claims). Keep it above PDF_EXTRACT_TIMEOUT_SECONDS plus AI_TIMEOUT_SECONDS.
WORKER_LEASE_SECONDS=180
# The worker's own /metrics port. Private: do not publish or route it (no token on it).
WORKER_METRICS_PORT=9100
# A row lock a worker query waits for longer than this fails the attempt instead of hanging.
WORKER_LOCK_TIMEOUT_SECONDS=5
# Both modes. PDF text is extracted in a child process killed at the deadline and capped in memory (address
# space, MB) and CPU time (seconds). A hit limit is stored as an unreadable document (pdf_parse_error).
PDF_EXTRACT_TIMEOUT_SECONDS=15
PDF_EXTRACT_MEMORY_MB=512
PDF_EXTRACT_CPU_SECONDS=10
