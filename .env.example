# PermitFlow environment. Copy to .env for local development. Never commit .env.

# Runtime: development | test | production
APP_ENV=development

# PostgreSQL (Postgres only; no SQLite fallback)
DATABASE_URL=postgresql+psycopg://permitflow:permitflow@localhost:5432/permitflow
# Used by pytest; created by docker/init-test-db.sql on first `docker compose up`
TEST_DATABASE_URL=postgresql+psycopg://permitflow:permitflow@localhost:5432/permitflow_test

# Auth. JWT_SECRET is required in every environment (at least 16 random characters; the placeholder below is refused).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=480
# One live session per account (US-093): a session unseen for this many minutes ends by itself.
SESSION_IDLE_MINUTES=60

# CORS allowlist for the frontend (comma separated)
CORS_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=10485760
# Everything one application holds on the volume (every document version, clarification evidence, the licence), US-085.
STORAGE_BUDGET_BYTES=157286400

# Proxy addresses whose X-Forwarded-For the limiters trust (the hop the proxy appended, never the caller's),
# or * behind a platform edge proxy such as Railway. Empty locally: the socket address is the client.
TRUSTED_PROXIES=
# Behind a trusted proxy, the header the edge writes with the connecting client's address, read before
# X-Forwarded-For (Railway: X-Real-IP; US-082). Ignored without a trusted proxy; empty disables it.
CLIENT_IP_HEADER=X-Real-IP
# Database connection pool (US-044). Exhaustion answers 503 after DB_POOL_TIMEOUT_SECONDS instead of hanging.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=5

# Failed sign-ins per client IP per minute (SEC-010); disabled when APP_ENV=test.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Request limits per client IP per minute (US-058): every request, and sign-in attempts of any outcome. 0 disables.
RATE_LIMIT_PER_MINUTE=240
LOGIN_ATTEMPTS_PER_MINUTE=20
# Quotas counted in the database (US-058): open drafts per operator; verification runs per applicant and per platform per day.
MAX_DRAFTS_PER_USER=20
AI_RUNS_PER_USER_PER_DAY=60
AI_RUNS_PER_DAY=1000

# AI verification. AI_PROVIDER=mock needs no key.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
AI_CONFIDENCE_THRESHOLD=0.6
AI_MAX_TEXT_CHARS=20000

# LangSmith tracing of the OpenAI provider (US-055). Off without a key. Region is fixed at sign-up:
# US https://api.smith.langchain.com, EU https://eu.api.smith.langchain.com, APAC (Sydney) https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=permitflow
# Inputs (document text, form section) hidden by default; set false in development only.
LANGSMITH_HIDE_INPUTS=true

# Frontend: Vite reads VITE_* from frontend/.env at build time (see frontend/.env.example), not from this file.

# Read by backend/scripts/seed.py only, never by the app: the demo accounts' password (default PermitFlow!2026).
# SEED_PASSWORD=PermitFlow!2026

# Observability (US-077). The API serves GET /api/v1/metrics only when METRICS_TOKEN is set; Prometheus
# presents it as a bearer token. Leave empty to keep the endpoint off. Generate: openssl rand -hex 24
METRICS_TOKEN=
# Local Prometheus and Grafana: docker compose --profile observability up -d (Grafana on :3001).
# METRICS_TARGET=host.docker.internal:8000   # backend:8000 when the backend runs in Compose (--profile full)
# GRAFANA_ADMIN_PASSWORD=permitflow
# Telegram alerts from Grafana (optional, US-077): a bot from @BotFather and the chat id of the conversation
# with it. Both set: the six rules and an hourly digest notify that chat; either empty: no alerting provisioned.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

