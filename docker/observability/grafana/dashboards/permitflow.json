  {
   "id": 103,
   "type": "row",
   "title": "What are the document checks costing?",
   "gridPos": {
    "x": 0,
    "y": 47,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 41,
   "type": "stat",
   "title": "Estimated OpenAI spend in the selected range",
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(increase(permitflow_openai_tokens_total{environment=~\"$environment\", kind=\"prompt\"}[$__range])) - sum(increase(permitflow_openai_tokens_total{environment=~\"$environment\", kind=\"cached\"}[$__range]))) * 0.4 / 1e6 + sum(increase(permitflow_openai_tokens_total{environment=~\"$environment\", kind=\"cached\"}[$__range])) * 0.1 / 1e6 + sum(increase(permitflow_openai_tokens_total{environment=~\"$environment\", kind=\"completion\"}[$__range])) * 1.6 / 1e6",
     "legendFormat": "Estimated OpenAI spend in the selected range",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
