    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "240 requests a minute per client, 20 sign-in attempts; a refusal answers 429 with Retry-After."
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Quota refusals (drafts, daily check limits)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (quota) (increase(permitflow_quota_refusals_total{environment=~\"$environment\"}[1h]))",
     "legendFormat": "{{quota}}",
